# PS5 Deal Tracker Configuration
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file to version control.

# PlayStation API Key from https://api.sh/
APISH_KEY=your_apish_key_here

# Telegram Deal Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Neon PostgreSQL Database URL (Leave empty or omit to use local SQLite ps5_deals.db)
# Example: postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=

# Optional: Retailer API Credentials (if available)
# Amazon Product Advertising API (PA-API 5.0)
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_ASSOCIATE_TAG=

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
